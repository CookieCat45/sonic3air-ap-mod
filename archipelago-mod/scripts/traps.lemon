function void DoSpringTrap()
{
	if (global.game_mode != 0x0c || !allocDynamicObjectStd())
		return
	
	s16 velX = s16[0xffffb000 + 0x18]
	s16 velY = s16[0xffffb000 + 0x1a]
	objA1.update_address = addressof(Spring.BaseUpdate)
	objA1.position.x.u16 = u16[0xffffb000 + 0x10]
	objA1.position.y.u16 = u16[0xffffb000 + 0x14]
	
	// Spawn a spring in front of the player
	if (abs(velY) > abs(velX))
	{
		if (velY > 0.0)
		{
			// face down
			objA1.position.y.u16 += 30
			objA1.subtype2c = 0x00
		}
		else if (velY < 0.0)
		{
			// face up
			objA1.position.y.u16 -= 30
			objA1.subtype2c = 0x20
		}
	}
	else // horizontal is greater (or they aren't moving)
	{
		objA1.subtype2c = 0x10
		if (velX < 0.0)
		{
			// face right
			objA1.position.x.u16 -= 30
		}
		else if (velX > 0.0)
		{
			// face left
			objA1.position.x.u16 += 30
			objA1.flags2a |= 0x01
		}
		else
		{
			// not moving - a left facing spring will bounce them
			objA1.flags2a |= 0x01
		}
	}
}

function void DoMissileTrap()
{
	if (global.game_mode != 0x0c)
		return
	
	for (u8 i = 0; i < 3; ++i)
	{
		if (!allocDynamicObjectStd())
			break

		objA1.update_address = 0x081fee
		objA1.value3e = 30 // countdown before missiles can collide with the player, so they don't instantly hit them on spawn
		u8[A1 + 0x2c] = 0x01
		u16[A1 + 0x46] = 0xffffb000
		u8[A1 + 0x39] = i
	}
	
	playSound(0x81)
}

//# address-hook(0x081fee) end(0x082030)
function void fn081fee()
{
	if (global.zone == 0x0c)
	{
		// behave normally in doomsday zone
		base.fn081fee()
		return
	}
	
	setupObjectAttributesFull(0x0831f0)

	// "spawnSimpleChildObjects(0x083250)" replaced by:
	//spawnSimpleChildObjects(0x08214a, 1)

	if (objA0.subtype2c == 0)
	{
		objA0.update_address = 0x082038
		u16[A0 + 0x3c] = 0xc006
		fn082aa6()
	}
	else
	{
		objA0.update_address = 0x082060
		//objA0.position.y.u16 += u16[0x082032 + objA0.value39 * 2]
		objA0.countdown_value = 0
		fn081fda()
	}
}

//# address-hook(0x082abc) end(0x082ad2)
function void fn082abc()
{
	if (global.zone == 0x0c)
	{
		base.fn082abc()
		return
	}
	
	// increase speed outside of doomsday zone
	D0.u8 = u8[A0 + 0x3c]
	LookupSinCos()
	objA0.velocity.x = D0.u16 * 4
	objA0.velocity.y = D1.u16 * 4
	UpdateMovementStraightSimple()
}

//# address-hook(0x082b06) end(0x082b80)
function void fn082b06()
{
	if (objA0.value3e > 0)
	{
		objA0.value3e--
		return
	}
	
	if (global.zone == 0x0c)
	{
		base.fn082b06()
		return
	}
	
	// Collision check for missiles
	/*
#if STANDALONE
	bool isSuperActive = isMainCharacter(CHARACTER_TAILS) ? super.active.tails : super.active
#else
	bool isSuperActive = super.active
#endif
	if (!isSuperActive)
		return
	*/
	
	u8 jumpLocation = 0
	if ((objA0.render_flags & render_flag.VISIBLE) && objA0.subtype2c != 0)
	{
		D0.u16 = u16[0xfffffaa4]
		if (D0.u16 != 0)
		{
			A1 = 0xffff0000 + D0.u16
			if (u8[A1 + 0x28] == 0)
			{
				A2 = 0x082bb4
				fn085898()
				if (!_equal())
				{
					--u8[A1 + 0x29]
					u8[A1 + 0x28] = 0xff
					jumpLocation = 0x082b78
				}
			}
		}
	}

	if (jumpLocation == 0)
	{
		A1 = 0xffffb000
		if (u8[A1 + 0x34] == 0)
		{
			// Targets:
			//  - 0x082bcc	-> u8[A0 + 0x3d] = 0x00
			//  - 0x082bd4	-> u8[A0 + 0x3d] = 0x01
			//  - 0x082bdc	-> u8[A0 + 0x3d] = 0x02
			//  - 0x082bd4	-> u8[A0 + 0x3d] = 0x03
			//  - 0x082bcc	-> u8[A0 + 0x3d] = 0x04
			//  - 0x082bd4	-> u8[A0 + 0x3d] = 0x05
			//  - 0x082bdc	-> u8[A0 + 0x3d] = 0x06
			//  - 0x082bd4	-> u8[A0 + 0x3d] = 0x07
			A2 = tableLookupAddress(0x082bbc, u8[A0 + 0x3d] * 2)

			fn0858c8()
			if (!_equal())
			{
				jumpLocation = 0x082b6e
			}
		}
	}
	
	if (jumpLocation == 0x082b6e)
	{
		//A1 = 0xffffb000
		//u8[A1 + 0x34] = 0x59
		jumpLocation = 0x082b78
	}
	else
	{
		/*
		D0.u16 = u16[A0 + 0x46]
		if (D0.u16 != 0)
		{
			A1 = 0xffff0000 + D0.u16
			if (u8[A1 + 0x2a] & 0x80)
			{
				jumpLocation = 0x082b84
			}
		}
		*/
	}

	if (jumpLocation == 0x082b78)
	{
		/*
		D0.u16 = u16[A0 + 0x46]
		if (D0.u16 != 0)
		{
			A1 = 0xffff0000 + D0.u16
			--u8[A1 + 0x39]
		}
		*/
		jumpLocation = 0x082b84
	}

	if (jumpLocation == 0x082b84)
	{
		fn082b84()
		DamageCharacter()
		playSound(0xb4)
	}
}

//# address-hook(0x082b84) end(0x082bb2)
function void fn082b84()
{
	if (global.zone == 0x0c)
	{
		base.fn082b84()
		return
	}
	
	objA0.update_address = 0x08565e
	objA0.countdown_value = 0x03
	objA0.countdown_callback = addressof(Enemy.UnloadDelayed)

	// "spawnSimpleChildObjects(0x083fee)" replaced by:
	//spawnSimpleChildObjects(0x083d84, 1)		// Boss explosion generator
	//if (_equal())
	//{
	//	u8[A1 + 0x2c] = 0x06
	//}
	objA0.flags2a |= 0x80
}
