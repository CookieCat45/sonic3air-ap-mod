function bool IsLocationInLogic(u32 id)
{
	if (!Archipelago.doesLocationExist(id) && !Archipelago.GetMonitorSanityMode())
		return false
	
	JsonReader data = Archipelago.getSlotData()
	data.enterRoot()
	data.enterObject("LocationCharWhitelists")
	string idStr = stringformat("%d", id)
	if (data.enterArray(idStr))
	{
		bool found = false
		for (u16 i = 0; data.hasIndex(i); i++)
		{
			if (data.getInteger(i) == global.characters)
			{
				found = true
				break
			}
		}
		
		data.enterRoot()
		if (!found)
		{
			return false
		}
	}
	
	data.enterRoot()
	return true
}

function void ResetTrackedObjectIDs()
{
	for (u8 i = 0; i < TrackedObjectIDs.length(); i++)
	{
		TrackedObjectIDs[i] = 0
		MonitorYPositions[i] = 0
		HiddenMonitors[i] = false
	}
}

function void RemoveTrackedObject(u32 id)
{
	for (u8 i = 0; i < TrackedObjectIDs.length(); i++)
	{
		if (TrackedObjectIDs[i] == id)
		{
			TrackedObjectIDs[i] = 0
			MonitorYPositions[i] = 0
			HiddenMonitors[i] = false
		}
	}
}

function void LevelObjectTableBuilder.buildObjects()
{
	ResetTrackedObjectIDs()
	base.LevelObjectTableBuilder.buildObjects()
}

function void LevelObjectTableBuilder.addObject(u16 px, u16 py, u8 type, u8 subtype, u8 flags)
{
	// Giant Ring, Monitor, Hidden Monitor
	if (type == 0x85 || type == 0x01 || type == 0x80)
	{
		u32 id = 0
		if (type == 0x85)
		{
			id = Archipelago.getObjectId_xyPos(px, py)
		}
		else if (type == 0x01 || type == 0x80)
		{
			id = Archipelago.getObjectId_Monitor(px, subtype)
		}
		
		if (!Archipelago.isLocationChecked(id) && (Archipelago.doesLocationExist(id) || Archipelago.GetMonitorSanityMode()))
		{
			for (u8 i = 0; i < TrackedObjectIDs.length(); i++)
			{
				if (TrackedObjectIDs[i] == 0)
				{
					TrackedObjectIDs[i] = id
					if (type == 0x01)
					{
						// stupid hack for monitors - track the Y position in a separate array
						// since we don't use the Y position for the location ID as it can change
						MonitorYPositions[i] = py
					}
					else if (type == 0x80)
					{
						// keep track of hidden monitors
						// we don't need the Y position since the compass doesn't track hidden monitors
						HiddenMonitors[i] = true
					}
					
					break
				}
			}
		}
	}
	
	base.LevelObjectTableBuilder.addObject(px, py, type, subtype, flags)
}

//# address-hook(0x00db44) end(0x00dbb2)
function void RenderHUD()
{
	base.RenderHUD()
	if (option.ap.checkCompass)
	{
		RenderCompass()
	}
}

function void RenderCompass()
{
	u16 charX = u16[0xffffb000 + 0x10]
	u16 charY = u16[0xffffb000 + 0x14]
	s16 closestX = 0
	s16 closestY = 0
	double closestDistance = 0
	bool found = false
	for (u8 i = 0; i < TrackedObjectIDs.length(); i++)
	{
		if (TrackedObjectIDs[i] == 0)
			continue
			
		if (!IsLocationInLogic(TrackedObjectIDs[i]))
			continue
		
		u16 px = TrackedObjectIDs[i] >> 16
		u16 py = 0
		if (MonitorYPositions[i] != 0)
		{
			py = MonitorYPositions[i]
		}
		else
		{
			py = TrackedObjectIDs[i] & 0xFFFF
		}
		
		double dx = double(charX) - double(px)
		double dy = double(charY) - double(py)
		double distance = Math.sqrt(dx * dx + dy * dy)
		if (!found || distance < closestDistance)
		{
			found = true
			closestDistance = distance
			closestX = px
			closestY = py
		}
	}
	
	if (found)
	{
		s16 dx = closestX - charX
		s16 dy = closestY - charY
		u8 angle = Math.u8FromDegrees(Math.radiansToDegrees(Math.atan2(dx, dy)))
		//System.writeDisplayLine(stringformat("Distance: %d, Angle: %d", distance, angle))
		Renderer.drawSprite("arrow", getScreenWidth()/2, (getScreenHeight()/2)+80, 0, SPRITE_FLAG_PRIO, 0xf005, -angle+64, 150)
		if (option.ap.checkCompass != 2)
		{
			Renderer.drawText(GamePause.DIALOG_FONT, getScreenWidth()/2, (getScreenHeight()/2)+100, stringformat("%d", closestDistance), 0xffffffff, 5, 0, 0xf006, false)
		}
	}
}