function u64 Archipelago.getZoneActIdOffset(u8 zone, u8 act)
{
	return ((zone+1) * 1000) + (act * 500)
}

function u64 Archipelago.getZoneActIdOffset64(u64 zone, u64 act)
{
	return ((zone+1) * 1000) + (act * 500)
}

function u8 Archipelago.GetZoneActsCompleted(u8 zone, bool knuckles)
{
	if (!Archipelago.IsKnucklesGoalNecessary())
	{
		knuckles = false
	}
	
	u32 addr = knuckles ? Addr.ZoneProgressStart.Knuckles + u32(zone) : Addr.ZoneProgressStart + u32(zone)
	string seed = Archipelago.getSeedName()
	System.loadPersistentData(addr, 4, "s3air_archipelago", stringformat("ZoneProgress%d_%d_%s", zone, knuckles, seed), false)
	u8 count = 0
	u8 val = u8[addr]
    while (val > 0)
	{
		val = val & (val - 1)
		count++
	}
	
	return count
}

function u8 Archipelago.GetZoneRequiredActCount(u8 zone)
{
	if (zone == 0x16 || zone == 0x0c || zone == 0x0a)
	{
		// Hidden Palace, Doomsday, Sky Sanctuary
		return 1
	}
	
	return 2
}

function bool Archipelago.AreAllZonesComplete(bool includeDeathEgg, bool includeDoomsday, bool knuckles)
{
	if (!Archipelago.IsKnucklesGoalNecessary())
	{
		knuckles = false
	}
	
	u8 count
	JsonReader data = Archipelago.getSlotData()
	for (u8 i = 0; i < ActSelect.ZONES.length(); i++)
	{
		string name = ActSelect.ZONES[i]
		if (!includeDeathEgg && name == "Death Egg Zone")
			continue
		
		if (!includeDoomsday && name == "Doomsday Zone")
			continue
			
		if (knuckles && name == "Sky Sanctuary Zone")
		{
			if (data.getInteger("KnucklesGoal") == Goal.ALLZONES_SANCTUARY)
			{
				continue
			}
		}
		
		if (!Archipelago.IsZoneAllowed(name))
			continue
		
		u8 zone = ActSelect.ZONE_INTERNAL_IDS[i]
		if (Archipelago.GetZoneActsCompleted(zone, knuckles) >= Archipelago.GetZoneRequiredActCount(zone))
		{
			count++
		}
	}

	u8 totalZones = data.getInteger("ZoneCount")
	if (knuckles && data.getInteger("KnucklesGoal") == Goal.ALLZONES_SANCTUARY)
	{
		totalZones--
	}
	
	if (!includeDeathEgg && Archipelago.IsZoneAllowed("Death Egg Zone"))
	{
		totalZones--
	}
	
	if (!includeDoomsday && Archipelago.IsZoneAllowed("Doomsday Zone"))
	{
		totalZones--
	}

	return count >= totalZones
}

function bool Archipelago.IsZoneAllowed(string zone)
{
	JsonReader data = Archipelago.getSlotData()
	data.enterRoot()
	if (zone == "Special Stage")
	{
		return data.getInteger("SpecialStageUnlockItemCount") > 0
	}
	
	data.enterArray("ZonesAllowed")
	for (u16 i = 0; data.hasIndex(i); i++)
	{
		if (data.getString(i) == zone)
		{
			data.enterRoot()
			return true
		}
	}
	
	data.enterRoot()
	return false
}

function bool Archipelago.IsZoneActComplete(u8 zone, u8 act, bool knuckles)
{
	if (!Archipelago.IsKnucklesGoalNecessary())
	{
		knuckles = false
	}
	
	u32 addr = knuckles ? Addr.ZoneProgressStart.Knuckles + u32(zone) : Addr.ZoneProgressStart + u32(zone)
	string seed = Archipelago.getSeedName()
	System.loadPersistentData(addr, 4, "s3air_archipelago", stringformat("ZoneProgress%d_%d_%s", zone, knuckles, seed), false)
	return (u8[addr] & (1 << act)) != 0
}

function bool Archipelago.IsZoneUnlocked(string zone, bool knuckles)
{
	if (!Archipelago.isConnected())
		return false
	
	if (!Archipelago.IsKnucklesGoalNecessary())
	{
		knuckles = false
	}
	
	JsonReader data = Archipelago.getSlotData()
	data.enterRoot()
	u8 unlockMode = data.getInteger("ZoneUnlockMode")
	if (zone == "Doomsday Zone")
	{
		u8 emeralds = Archipelago.getItemCount(Item.CHAOS_EMERALD)
		if (!knuckles)
		{
			u8 goal = data.getInteger("Goal")
			if (goal == Goal.DOOMSDAY)
			{
				return emeralds >= 7
			}
			else if (goal == Goal.DOOMSDAY_HYPER)
			{
				return emeralds >= 14
			}
			else if (goal == Goal.ALLZONES_DOOMSDAY)
			{
				return Archipelago.AreAllZonesComplete(true, false, false) && emeralds >= 7
			}
			else if (goal == Goal.ALLZONES_DOOMSDAY_HYPER)
			{
				return Archipelago.AreAllZonesComplete(true, false, false) && emeralds >= 14
			}
		}

		return false
	}
	else if (zone == "Special Stage")
	{
		return Archipelago.getItemCount(Item.PROGRESSIVE_SPECIAL_UNLOCK) > 0
	}
	else if (knuckles && zone == "Sky Sanctuary Zone" && data.getInteger("KnucklesGoal") == Goal.ALLZONES_SANCTUARY)
	{
		return Archipelago.AreAllZonesComplete(true, false, true)
	}
	else if (unlockMode == ZoneUnlockMode.LINEAR)
	{
		u8 index = -1
		string zones[14]
		data.enterRoot()
		data.enterArray("ZonesAllowed")
		for (u8 i = 0; data.hasIndex(i); i++)
		{
			zones[i] = data.getString(i)
			if (zones[i] == zone)
			{
				index = i
				break
			}
		}

		data.enterRoot()
		u8 prevZoneId = -1
		if (index > 0)
		{
			// previous zone needs to be completed first
			prevZoneId = Archipelago.ZoneNameToId(zones[index-1])
		}
		
		return index >= 0 && (prevZoneId == -1 || Archipelago.GetZoneActsCompleted(prevZoneId, knuckles) >= Archipelago.GetZoneRequiredActCount(prevZoneId)) && Archipelago.getItemCount(Item.PROGRESSIVE_ZONE_UNLOCK) >= index+1
	}
	else if (zone == "Death Egg Zone")
	{
		if (unlockMode == ZoneUnlockMode.SHUFFLED_DEATHEGG)
		{
			return Archipelago.AreAllZonesComplete(false, false, knuckles)
		}
	}
	
	return (Archipelago.getItemCount(Archipelago.ZoneNameToItem(zone)) > 0)
}

function string Archipelago.GetZoneNameInternal(u8 id)
{
	if (id == 0x00)
		return "Angel Island Zone"
	else if (id == 0x01)
		return "Hydrocity Zone"
	else if (id == 0x02)
		return "Marble Garden Zone"
	else if (id == 0x03)
		return "Carnival Night Zone"
	else if (id == 0x05)
		return "IceCap Zone"
	else if (id == 0x06)
		return "Launch Base Zone"
	else if (id == 0x07)
		return "Mushroom Hill Zone"
	else if (id == 0x04)
		return "Flying Battery Zone"
	else if (id == 0x08)
		return "Sandopolis Zone"
	else if (id == 0x09)
		return "Lava Reef Zone"
	else if (id == 0x16)
		return "Hidden Palace Zone"
	else if (id == 0x0a)
		return "Sky Sanctuary Zone"
	else if (id == 0x0b)
		return "Death Egg Zone"
	else if (id == 0x0c)
		return "Doomsday Zone"
	
	return stringformat("UNKNOWN Zone [0x%x]", id)
}

function u8 Archipelago.ZoneNameToId(string zone)
{
	if (zone == "Angel Island Zone")
		return 0x00
	else if (zone == "Hydrocity Zone")
		return 0x01
	else if (zone == "Marble Garden Zone")
		return 0x02
	else if (zone == "Carnival Night Zone")
		return 0x03
	else if (zone == "IceCap Zone")
		return 0x05
	else if (zone == "Launch Base Zone")
		return 0x06
	else if (zone == "Mushroom Hill Zone")
		return 0x07
	else if (zone == "Flying Battery Zone")
		return 0x04
	else if (zone == "Sandopolis Zone")
		return 0x08
	else if (zone == "Lava Reef Zone")
		return 0x09
	else if (zone == "Hidden Palace Zone")
		return 0x16
	else if (zone == "Sky Sanctuary Zone")
		return 0x0a
	else if (zone == "Death Egg Zone")
		return 0x0b
	else if (zone == "Doomsday Zone")
		return 0x0c
		
	return 0xFF
}

function u64 Archipelago.ZoneNameToItem(string zone)
{
	if (zone == "Angel Island Zone")
	{
		return Item.UNLOCK_ANGELISLAND
	}
	else if (zone == "Hydrocity Zone")
	{
		return Item.UNLOCK_HYDROCITY
	}
	else if (zone == "Marble Garden Zone")
	{
		return Item.UNLOCK_MARBLEGARDEN
	}
	else if (zone == "Carnival Night Zone")
	{
		return Item.UNLOCK_CARNIVALNIGHT
	}
	else if (zone == "IceCap Zone" || zone == "Ice Cap Zone")
	{
		return Item.UNLOCK_ICECAP
	}
	else if (zone == "Launch Base Zone")
	{
		return Item.UNLOCK_LAUNCHBASE
	}
	else if (zone == "Mushroom Hill Zone")
	{
		return Item.UNLOCK_MUSHROOMHILL
	}
	else if (zone == "Flying Battery Zone")
	{
		return Item.UNLOCK_FLYINGBATTERY
	}
	else if (zone == "Sandopolis Zone")
	{
		return Item.UNLOCK_SANDOPOLIS
	}
	else if (zone == "Lava Reef Zone")
	{
		return Item.UNLOCK_LAVAREEF
	}
	else if (zone == "Hidden Palace Zone")
	{
		return Item.UNLOCK_HIDDENPALACE
	}
	else if (zone == "Sky Sanctuary Zone")
	{
		return Item.UNLOCK_SKYSANCTUARY
	}
	else if (zone == "Death Egg Zone")
	{
		return Item.UNLOCK_DEATHEGG
	}
	
	return -1
}
