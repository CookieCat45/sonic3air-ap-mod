//# script-feature-level(2)
include tweaks
include specialstages
include helpers
include zones
include compass
include actselect_ap
include monitor_ap

constant u32 Addr.LastItemIndex = 0x880100
constant u32 Addr.ItemEffectFlags = 0x880104
constant u32 Addr.StoredLives = 0x880108
constant u32 Addr.StoredRings = 0x880112
constant u32 Addr.ZoneProgressStart = 0x880150
constant u32 Addr.ZoneProgressStart.Knuckles = 0x880250

// Items
constant u64 Item.TENRINGS = 2020300001
constant u64 Item.EXTRALIFE = 2020300002
constant u64 Item.FIRESHIELD = 2020300003
constant u64 Item.BUBBLESHIELD = 2020300004
constant u64 Item.ELECTRICSHIELD = 2020300005
constant u64 Item.INVINCIBILITY = 2020300006
constant u64 Item.SPEEDSHOES = 2020300007
constant u64 Item.SONIC = 2020300008
constant u64 Item.TAILS = 2020300009
constant u64 Item.KNUCKLES = 2020300010
constant u64 Item.UNLOCK_ANGELISLAND = 2020300011
constant u64 Item.UNLOCK_HYDROCITY = 2020300012
constant u64 Item.UNLOCK_MARBLEGARDEN = 2020300013
constant u64 Item.UNLOCK_CARNIVALNIGHT = 2020300014
constant u64 Item.UNLOCK_ICECAP = 2020300015
constant u64 Item.UNLOCK_LAUNCHBASE = 2020300016
constant u64 Item.UNLOCK_MUSHROOMHILL = 2020300017
constant u64 Item.UNLOCK_FLYINGBATTERY = 2020300018
constant u64 Item.UNLOCK_SANDOPOLIS = 2020300019
constant u64 Item.UNLOCK_LAVAREEF = 2020300020
constant u64 Item.UNLOCK_HIDDENPALACE = 2020300021
constant u64 Item.UNLOCK_SKYSANCTUARY = 2020300022
constant u64 Item.UNLOCK_DEATHEGG = 2020300023
constant u64 Item.PROGRESSIVE_ZONE_UNLOCK = 2020300024
constant u64 Item.PROGRESSIVE_SPECIAL_UNLOCK = 2020300025
constant u64 Item.CHAOS_EMERALD = 2020300026

// Option values (from the apworld)
constant u8 Goal.ALLZONES = 0
constant u8 Goal.DOOMSDAY = 1 
constant u8 Goal.DOOMSDAY_HYPER = 2
constant u8 Goal.ALLZONES_DOOMSDAY = 3
constant u8 Goal.ALLZONES_DOOMSDAY_HYPER = 4
constant u8 Goal.ALLZONES_SANCTUARY = 5

constant u8 ZoneUnlockMode.LINEAR = 0
constant u8 ZoneUnlockMode.SHUFFLED = 1
constant u8 ZoneUnlockMode.SHUFFLED_DEATHEGG = 2

constant u8 KnucklesStoryMode.NORMAL = 0
constant u8 KnucklesStoryMode.GOAL = 1
constant u8 KnucklesStoryMode.REMOVED = 2
constant u8 KnucklesStoryMode.EXCLUSIVE = 3
constant u8 KnucklesStoryMode.EXCLUSIVE_TAILS = 4

// Mod options
global u8 option.ap.checkCompass
global u8 option.ap.deathLink
global u8 option.ap.monitorTest

// Other variables
global u32 TrackedObjectIDs[255]
global u16 MonitorYPositions[255]
global bool DeathLinked = false

function void Init()
{
	base.Init()
	ResetTrackedObjectIDs()
	if (!Archipelago.isConnected())
	{
		Archipelago.start()
	}
	else
	{
		LoadPersistent()
	}
}

function void Archipelago.OnConnected()
{
	System.writeDisplayLine("Connected to Archipelago!")
	LoadPersistent()
	if (global.game_mode == 0x4c || global.game_mode == 0x1c)
	{
		// Get out of the data select/level select screen if we're in there somehow
		Game.returnToMainMenu()
	}
}

function void Archipelago.OnDisconnected()
{
	System.writeDisplayLine("Lost connection to Archipelago server")
}

function void LoadPersistent()
{
	string seedName = Archipelago.getSeedName()
	System.loadPersistentData(Addr.LastItemIndex, 4, "s3air_archipelago", stringformat("LastItemIndex_%s", seedName), false)
	System.loadPersistentData(Addr.ItemEffectFlags, 4, "s3air_archipelago", stringformat("ItemEffectFlags_%s", seedName), false)
	System.loadPersistentData(Addr.StoredRings, 4, "s3air_archipelago", stringformat("StoredRings_%s", seedName), false)
	System.loadPersistentData(Addr.StoredLives, 4, "s3air_archipelago", stringformat("StoredLives_%s", seedName), false)
}

function void SavePersistent()
{
	string seedName = Archipelago.getSeedName()
	System.savePersistentData(Addr.LastItemIndex, 4, "s3air_archipelago", stringformat("LastItemIndex_%s", seedName), false)
	System.savePersistentData(Addr.ItemEffectFlags, 4, "s3air_archipelago", stringformat("ItemEffectFlags_%s", seedName), false)
	System.savePersistentData(Addr.StoredRings, 4, "s3air_archipelago", stringformat("StoredRings_%s", seedName), false)
	System.savePersistentData(Addr.StoredLives, 4, "s3air_archipelago", stringformat("StoredLives_%s", seedName), false)
}

function void Game.onZoneActCompleted(u16 zoneAndAct)
{
	if (Game.isTimeAttack() || global.rolling_demo)
	{
		return
	}
	
	u8 zone = zoneAndAct >> 8
	u8 act = zoneAndAct & 0xFF
	u32 addr = Addr.ZoneProgressStart + u32(zone)
	bool knuckles = isMainCharacter(CHARACTER_KNUCKLES) && Archipelago.IsKnucklesGoalNecessary()
	if (knuckles)
	{
		addr = Addr.ZoneProgressStart.Knuckles + u32(zone)
	}
	
	// Fix some oddities with zone/act IDs
	if (zone == 0x16 && act == 0x00) // Lava Reef Act 2 boss
	{
		zone = 0x09
		act = 0x01
	}
	else if (zone == 0x17) // Death Egg giant robot
	{
		zone = 0x0b
		act = 0x01
	}
	
	string seed = Archipelago.getSeedName()
	System.loadPersistentData(addr, 4, "s3air_archipelago", stringformat("ZoneProgress%d_%d_%s", zone, knuckles, seed), false)
	u8[addr] |= 1 << act
	System.savePersistentData(addr, 4, "s3air_archipelago", stringformat("ZoneProgress%d_%d_%s", zone, knuckles, seed), false)
	u64 id = Archipelago.getZoneActIdOffset64(zone, act)
	LogDec = stringformat("%s Act %d: %d", Archipelago.GetZoneNameInternal(zone), act, id)
	Archipelago.sendLocation(id)
	Archipelago.CheckGoalCompletion()
}

function void Archipelago.OnNewItem(string item, u64 id, u64 flags)
{
	System.writeDisplayLine(stringformat("Got Item: %s", item))
	if (item == "Invincibility")
	{
		u32[Addr.ItemEffectFlags] |= char.bonus.INVINCIBLE
	}
	else if (item == "Speed Shoes")
	{
		u32[Addr.ItemEffectFlags] |= char.bonus.SPEED_UP
	}
	else if (item == "Fire Shield")
	{
		u32[Addr.ItemEffectFlags] &= ~char.bonus.ALL_SHIELDS
		u32[Addr.ItemEffectFlags] |= char.bonus.SHIELD_FIRE
	}
	else if (item == "Bubble Shield")
	{
		u32[Addr.ItemEffectFlags] &= ~char.bonus.ALL_SHIELDS
		u32[Addr.ItemEffectFlags] |= char.bonus.SHIELD_BUBBLE
	}
	else if (item == "Electric Shield")
	{
		u32[Addr.ItemEffectFlags] &= ~char.bonus.ALL_SHIELDS
		u32[Addr.ItemEffectFlags] |= char.bonus.SHIELD_LIGHTNING
	}
	else if (item == "10 Rings")
	{
		u32[Addr.StoredRings] += 10
	}
	else if (item == "Extra Life")
	{
		u32[Addr.StoredLives]++
	}
}

function void Archipelago.OnPostReceivedItems(s32 highestIndex, bool progression)
{
	string seed = Archipelago.getSeedName()
	if (s32[Addr.LastItemIndex] == 0)
	{
		// just in case
		System.loadPersistentData(Addr.LastItemIndex, 4, "s3air_archipelago", stringformat("LastItemIndex_%s", seed), false)
	}
	
	if (highestIndex > s32[Addr.LastItemIndex])
	{
		s32[Addr.LastItemIndex] = highestIndex
		System.savePersistentData(Addr.LastItemIndex, 4, "s3air_archipelago", stringformat("LastItemIndex_%s", seed), false)
		if (progression)
		{
			playSound(0xb0)
		}
	}
	
	Archipelago.UpdateEmeraldCount()
	SavePersistent()
}

global u8 UpdateDelay = 10
global bool EmeraldsUpdated = false
function void OnCharacterUpdate(u8 charId)
{
	if (global.rolling_demo || Game.isTimeAttack())
	{
		return
	}
	
	if (!EmeraldsUpdated)
	{
		Archipelago.UpdateEmeraldCount()
		EmeraldsUpdated = true
	}
	
	// this is to avoid accidentally wasting consumables in levels that start with cutscenes, e.g. AIZ 1
	// as there is a short window where the "in cutscene" flag is not set
	if (UpdateDelay > 0)
	{
		UpdateDelay--
		return
	}
	
	// Player is probably in a cutscene (e.g. AIZ intro) so wait before giving them consumables
	if (char.control_flags & (control_flag.DISABLE_WALLS|control_flag.DISABLE_UPDATE|control_flag.DISABLE_ANIMATION))
	{
		return
	}
	
	bool save = false
	// Process items with instant effects
	// Rings
	if (u32[Addr.StoredRings] > 0)
	{
		addRings(u32[Addr.StoredRings])
		u32[Addr.StoredRings] = 0
		save = true
	}
	
	// Lives
	while (u32[Addr.StoredLives] > 0)
	{
		gainExtraLife()
		u32[Addr.StoredLives]--
		save = true
	}
	
	if (u32[Addr.ItemEffectFlags])
	{
		save = true
		if (u32[Addr.ItemEffectFlags] & char.bonus.INVINCIBLE)
		{
			Archipelago.ApplyInvincibility()
		}
		
		if (u32[Addr.ItemEffectFlags] & char.bonus.SPEED_UP)
		{
			Archipelago.ApplySpeedUp()
		}
		
		if ((char.bonus_effect & char.bonus.ANY_SHIELD) == 0)
		{
			if (u32[Addr.ItemEffectFlags] & char.bonus.SHIELD_FIRE)
			{
				fn0611d6()
				char.bonus_effect |= char.bonus.ANY_SHIELD
			}
			else if (u32[Addr.ItemEffectFlags] & char.bonus.SHIELD_BUBBLE)
			{
				fn061200()
				char.bonus_effect |= char.bonus.ANY_SHIELD
			}
			else if (u32[Addr.ItemEffectFlags] & char.bonus.SHIELD_LIGHTNING)
			{
				fn06122a()
				char.bonus_effect |= char.bonus.ANY_SHIELD
			}
		}
		else
		{
			// If we already had a shield, give 5 rings for compensation
			addRings(5)
		}
		
		u32[Addr.ItemEffectFlags] = 0
	}
	
	if (save)
	{
		SavePersistent()
	}
}

//# address-hook(0x010a94) end(0x010ae8)
function void Character.BaseUpdate.Sonic()
{
	base.Character.BaseUpdate.Sonic()
	OnCharacterUpdate(CHARACTER_SONIC)
}

//# address-hook(0x01365c) end(0x0136b8)
function void Character.BaseUpdate.Tails()
{
	base.Character.BaseUpdate.Tails()
	OnCharacterUpdate(CHARACTER_TAILS)
}

//# address-hook(0x016444) end(0x016498)
function void Character.BaseUpdate.Knuckles()
{
	base.Character.BaseUpdate.Knuckles()
	OnCharacterUpdate(CHARACTER_KNUCKLES)
}

